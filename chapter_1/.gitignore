# --- Build output -----------------------------------------------------------
# All builds go in build/ (or out/ for Visual Studio's CMake mode).
build/
out/
cmake-build-*/          # CLion's default build folders

# --- Compiled files (in case something ever builds in the source tree) ------
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb                   # MSVC debug symbols
*.ilk                   # MSVC incremental link files

# --- CMake leftovers (if someone runs cmake from the root by mistake) -------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json   # personal presets, each dev has their own

# --- Tooling ----------------------------------------------------------------
compile_commands.json   # generated by CMake, used by clangd/clang-tidy
.cache/                 # clangd index

# --- IDEs / editors ---------------------------------------------------------
.vs/                    # Visual Studio
*.user
*.suo
.vscode/                # VS Code (some teams commit parts of it, fine to ignore at first)
.idea/                  # CLion / JetBrains
*.swp                   # vim

# --- OS junk ----------------------------------------------------------------
.DS_Store               # macOS
Thumbs.db               # Windows
